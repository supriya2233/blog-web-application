<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Page Not Found - Blog</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>


<body>


    <header class="site-header">

        <div class="container">

            <div class="top-bar">

                <div class="brand">

                    <h1 class="site-title">
                        Blog
                    </h1>

                    <p class="site-definition">
                        A blog is a regularly updated website or web page
                        where an individual or group shares ideas, stories,
                        experiences, knowledge, or information.
                    </p>

                </div>


                <div class="header-actions">

                    <button
                        id="theme-toggle"
                        class="theme-toggle"
                        type="button"
                    >
                        ☾
                    </button>

                </div>

            </div>

        </div>

    </header>


    <main class="container">

        <section class="error-section">

            <h2>
                404
            </h2>

            <h3>
                Page Not Found
            </h3>

            <p>
                Sorry, the page you are looking for does not exist.
            </p>


            <a
                href="/"
                class="btn btn-primary"
            >
                Back to Blog
            </a>

        </section>

    </main>


    <script src="/js/theme.js"></script>

</body>

</html>