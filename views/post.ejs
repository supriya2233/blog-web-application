
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= post.title %> | Blog</title>
    <%
        const metaExcerpt = (Array.isArray(post.content)
            ? post.content.map(b => b.text).join(' ')
            : String(post.content || '')
        ).slice(0, 160).trim();
    %>
    <meta name="description" content="<%= metaExcerpt %>">
    <meta property="og:title" content="<%= post.title %> | Blog">
    <meta property="og:description" content="<%= metaExcerpt %>">
    <meta property="og:type" content="article">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header class="site-header">
        <div class="header-content">
            <div class="brand">
                <a href="/" class="brand-title">Blog</a>
                <p class="brand-description">
                    A blog is a space to share ideas, knowledge, stories, and experiences.
                </p>
            </div>

            <nav class="header-nav">
                <a href="/" class="nav-link">Home</a>
                <a href="/posts/new" class="nav-link">Create Post</a>

                <button
                    type="button"
                    id="theme-toggle"
                    class="theme-toggle"
                    aria-label="Switch theme"
                    title="Switch theme"
                >
                    <span id="theme-icon" aria-hidden="true">☾</span>
                    <span id="theme-label">Dark mode</span>
                </button>
            </nav>
        </div>
    </header>

    <main class="container">
        <article class="article-detail">
            <a href="/" class="clear-filters">← Back to Articles</a>

            <header class="article-header">
                <% if (post.category) { %>
                    <span class="post-category"><%= post.category %></span>
                <% } %>

                <h1><%= post.title %></h1>

                <div class="article-meta">
                    <span class="post-author">By <%= post.author %></span>
                    <%
                        const totalWords = (Array.isArray(post.content)
                            ? post.content.reduce((n, b) => n + (b.text || '').trim().split(/\s+/).filter(Boolean).length, 0)
                            : String(post.content || '').trim().split(/\s+/).filter(Boolean).length
                        );
                        const readTime = Math.max(1, Math.ceil(totalWords / 200));
                    %>
                    <span class="article-word-count"><%= totalWords %> words &middot; <%= readTime %> min read</span>
                </div>
            </header>

            <div class="article-body">
                <% if (Array.isArray(post.content)) { %>
                    <% post.content.forEach(block => { %>
                        <% if (block.type === "heading") { %>
                            <h2><%= block.text %></h2>
                        <% } else { %>
                            <p><%= block.text %></p>
                        <% } %>
                    <% }) %>
                <% } else { %>
                    <% String(post.content || "").split(/\n\s*\n/).forEach(paragraph => { %>
                        <% if (paragraph.trim()) { %>
                            <p><%= paragraph %></p>
                        <% } %>
                    <% }) %>
                <% } %>
            </div>

            <div class="post-actions">
                <a
                    href="/posts/<%= post.id %>/edit"
                    class="edit-button"
                >
                    Edit Article
                </a>

                <button
                    class="copy-link-btn"
                    id="copy-link-btn"
                    type="button"
                    aria-label="Copy link to this article"
                >
                    📋 Copy Link
                </button>

                <form
                    action="/posts/<%= post.id %>/delete"
                    method="POST"
                    onsubmit="return confirm('Are you sure you want to delete this post?');"
                >
                    <button type="submit" class="delete-button">
                        Delete Article
                    </button>
                </form>
            </div>
        </article>
    </main>

    <footer class="site-footer">
        <p>
            © <%= new Date().getFullYear() %> My Blog. All rights reserved.
        </p>
    </footer>

    <script src="/js/theme.js"></script>
    <script>
        const copyBtn = document.getElementById('copy-link-btn');
        if (copyBtn) {
            copyBtn.addEventListener('click', () => {
                navigator.clipboard.writeText(window.location.href).then(() => {
                    copyBtn.textContent = '✓ Copied!';
                    copyBtn.classList.add('copy-link-btn--success');
                    setTimeout(() => {
                        copyBtn.textContent = '📋 Copy Link';
                        copyBtn.classList.remove('copy-link-btn--success');
                    }, 2000);
                });
            });
        }
    </script>
</body>
</html>
