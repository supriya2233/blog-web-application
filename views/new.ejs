<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Create Post - Blog</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>


<body>


    <!-- =========================
         HEADER
    ========================== -->

    <header class="site-header">

        <div class="container">

            <div class="top-bar">

                <div class="brand">

                    <h1 class="site-title">
                        Blog
                    </h1>

                    <p class="site-definition">
                        A blog is a regularly updated website or web page
                        where an individual or group shares ideas, stories,
                        experiences, knowledge, or information.
                    </p>

                </div>


                <div class="header-actions">

                    <a
                        href="/"
                        class="btn btn-edit"
                    >
                        ← Back
                    </a>

                </div>

            </div>

        </div>

    </header>


    <!-- =========================
         CREATE FORM
    ========================== -->

    <main class="container">

        <section class="form-section">

            <h2>
                Create New Post
            </h2>


            <% if (typeof error !== 'undefined' && error) { %>
                <div class="form-error-banner" role="alert">
                    <span class="form-error-icon" aria-hidden="true">⚠</span>
                    <%= error %>
                </div>
            <% } %>

            <form
                action="/posts"
                method="POST"
                class="post-form"
            >


                <!-- Title -->

                <div class="form-group">

                    <label for="title">
                        Title
                    </label>


                    <input
                        type="text"
                        id="title"
                        name="title"
                        placeholder="Enter your post title"
                        value="<%= (typeof formData !== 'undefined' && formData.title) ? formData.title : '' %>"
                        required
                    >

                </div>


                <!-- Category -->

                <div class="form-group">

                    <label for="category">
                        Category
                    </label>


                    <input
                        type="text"
                        id="category"
                        name="category"
                        placeholder="e.g. Technology, Lifestyle, Finance"
                        value="<%= (typeof formData !== 'undefined' && formData.category) ? formData.category : '' %>"
                        required
                    >

                </div>


                <!-- Author -->

                <div class="form-group">

                    <label for="author">
                        Author
                    </label>


                    <input
                        type="text"
                        id="author"
                        name="author"
                        placeholder="Enter your name"
                        value="<%= (typeof formData !== 'undefined' && formData.author) ? formData.author : '' %>"
                        required
                    >

                </div>


                <!-- Content -->

                <div class="form-group">

                    <label for="content">
                        Content
                    </label>


                    <textarea
                        id="content"
                        name="content"
                        rows="12"
                        placeholder="Write your blog post here..."
                        required
                    ><%= (typeof formData !== 'undefined' && formData.content) ? formData.content : '' %></textarea>


                    <p class="form-help">

                        Separate paragraphs with a blank line.
                        Use <strong>##</strong> before a line to create a section heading.

                    </p>

                </div>


                <!-- Actions -->

                <div class="form-actions">

                    <a
                        href="/"
                        class="btn btn-edit"
                    >
                        Cancel
                    </a>


                    <button
                        type="submit"
                        class="btn btn-primary"
                    >
                        Publish Post
                    </button>

                </div>


            </form>

        </section>

    </main>


    <script src="/js/theme.js"></script>

</body>

</html>